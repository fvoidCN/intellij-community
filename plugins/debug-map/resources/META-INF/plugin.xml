<idea-plugin package="com.intellij.debugmap">
  <name>Debug Map</name>
  <id>com.intellij.debugmap</id>
  <category>Debugger</category>
  <description><![CDATA[
    Debug Map — colored breakpoint groups with git-style workflow (checkout / commit / stash / pop).
    Turns breakpoints into persistent, semantic artifacts that survive across debugging sessions.
  ]]></description>
  <vendor>JetBrains</vendor>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="com.intellij.debugmap.sync.BreakpointSyncStartupActivity"/>
    <toolWindow id="Debug Map"
                anchor="right"
                secondary="true"
                icon="AllIcons.Debugger.MultipleBreakpoints"
                factoryClass="com.intellij.debugmap.ui.DebugMapToolWindowFactory"/>
  </extensions>
  <depends>com.intellij.mcpServer</depends>

  <resource-bundle>messages.DebugMapBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij.mcpServer">
    <mcpToolset implementation="com.intellij.debugmap.mcp.DebugToolset"/>
    <mcpToolset implementation="com.intellij.debugmap.mcp.BookmarkToolset"/>
  </extensions>

  <projectListeners>
    <listener class="com.intellij.debugmap.listener.DebugMapBreakpointListener"
              topic="com.intellij.xdebugger.breakpoints.XBreakpointListener"/>
    <listener class="com.intellij.debugmap.listener.DebugMapFileEditorListener"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    <listener class="com.intellij.debugmap.listener.DebugMapFileReloadListener"
              topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
  </projectListeners>

</idea-plugin>
